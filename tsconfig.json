{
  "compileOnSave": false,
  "compilerOptions": {
    "resolveJsonModule": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "target": "ES2022",
    "module": "ES2022",
    "lib": [
      "ES2022",
      "dom"
    ],
    "skipLibCheck": true,
    "strict": false
  },
  "angularCompilerOptions": {
    "strictTemplates": false,
    "strictInjectionParameters": false,
    "strictInputAccessModifiers": false
  }
}
